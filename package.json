    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "date-fns": "4.4.0",
    "lucide-react": "1.17.0",
    "msw": "^2.12.13",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.78.0",
    "react-router-dom": "7.17.0",
    "recharts": "3.8.1",
